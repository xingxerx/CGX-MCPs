{
  "mcpServers": {
    "cgx-serena": {
      "command": "uvx",
      "args": [
        "mcp-compressor",
        "http://localhost:9121/sse",
        "--server-name",
        "serena",
        "--compression-level",
        "medium"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    "cgx-gitmcp-synoid": {
      "command": "uvx",
      "args": [
        "mcp-compressor",
        "https://gitmcp.io/xingxerx/SYNOID",
        "--server-name",
        "synoid"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    "cgx-gitmcp-qallow": {
      "command": "uvx",
      "args": [
        "mcp-compressor",
        "https://gitmcp.io/xingxerx/Qallow",
        "--server-name",
        "qallow"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    "cgx-token-optimizer": {
      "command": "node",
      "args": [
        "C:\\Users\\xing\\AppData\\Roaming\\npm\\node_modules\\@ooples\\token-optimizer-mcp\\dist\\server\\index.js"
      ],
      "env": {
        "TOKEN_OPTIMIZER_CACHE_DIR": "C:\\Users\\xing\\.token-optimizer-cache"
      }
    }
  }
}